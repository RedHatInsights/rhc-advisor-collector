[Unit]
Description=Red Hat Advisor Collector
After=network.target
Documentation=https://github.com/RedHatInsights/rhc-advisor-collector

# Only try to restart six times
StartLimitIntervalSec=12h
StartLimitBurst=6

[Service]
Type=oneshot
ExecStart=/usr/libexec/rhc/rhc-collector run com.redhat.advisor
Restart=on-failure
RestartSec=1h

# CAP_SETUID/CAP_SETGID: rhc-collector applies the collector TOML's user/group
# on exec (com.redhat.advisor.toml runs root:root, so this is a no-op here,
# but rhc-collector takes the same code path regardless of target user).
# Insights Core must run as root to read protected host data. Keep only the
# extra privileges used by protected-file collection, Malware process scans,
# and dmesg collection.
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_DAC_READ_SEARCH CAP_SYS_PTRACE CAP_SYSLOG

# Keep NoNewPrivileges disabled so SELinux can transition from init_t to
# insights_client_t.
NoNewPrivileges=no

ProtectSystem=strict
ProtectHome=read-only
PrivateMounts=yes
# rhc-collector's own scratch/output directory for this collector.
ReadWritePaths=/var/cache/rhc/collectors
CacheDirectory=rhc/collectors

# Insights Core's SELinux-labeled temp files can't be cleaned up by PrivateTmp
PrivateTmp=no
ReadWritePaths=/tmp /var/tmp

ProtectClock=yes
ProtectHostname=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes

# Not ProtectKernelModules=/ProtectKernelLogs=/PrivateDevices=yes:
# insights-client.service omits all three for the same engine. ProtectKernelLogs
# would specifically conflict with CAP_SYSLOG above (dmesg collection).
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes

# Not a bare `yes`: insights-client.service only restricts user namespaces.
RestrictNamespaces=~user
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native

SystemCallFilter=@system-service
# Keep @debug available for Malware's live process scan. Block mount and
# privileged syscalls as well as clock, module, obsolete, raw-I/O, reboot, and
# swap operations.
SystemCallFilter=~@clock @cpu-emulation @module @mount @obsolete @raw-io @reboot @swap
SystemCallErrorNumber=EPERM
UMask=0077

# parameters from insights-client.service
CPUQuota=30%
MemoryHigh=1G
MemoryMax=2G
TasksMax=300
BlockIOWeight=100
